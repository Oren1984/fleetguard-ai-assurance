# ---------------------------------------------------------------------------
# FleetGuard AI - environment configuration
# Copy this file to .env and adjust values. The system runs fully in MOCK
# mode with no keys set - no external API calls are required for the demo.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------
POSTGRES_USER=fleetguard
POSTGRES_PASSWORD=fleetguard
POSTGRES_DB=fleetguard
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://fleetguard:fleetguard@db:5432/fleetguard

# --- LLM provider ---------------------------------------------------------
# "mock" (default) needs no API key and produces deterministic, fully
# grounded explanations built from real evidence and retrieved SOP text.
# Set to "openai" or "anthropic" to use a real provider instead.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Risk engine thresholds -----------------------------------------------
RISK_LEVEL_MEDIUM_THRESHOLD=40
RISK_LEVEL_HIGH_THRESHOLD=70
DEFAULT_CARGO_SETPOINT_C=4.0

# --- RAG --------------------------------------------------------------
SOP_MIN_SIMILARITY=0.08
SOP_DOCS_DIR=sop_docs

# --- Synthetic data ---------------------------------------------------
SYNTHETIC_TRUCK_COUNT=25
SEED_ON_STARTUP=true
RANDOM_SEED=42

# --- API --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Dashboard ----------------------------------------------------------
API_BASE_URL=http://backend:8000
